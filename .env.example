# =====================================================================
# ScholarSync - Database & Environment Configuration Template (.env.example)
# =====================================================================
# Copy this file to .env and configure your Supabase credentials:
#   copy .env.example .env
#
# The backend and launcher read these credentials automatically.
# =====================================================================

# 1. Your Supabase Project Reference (e.g. abcdefghijklmnopqrst)
SUPABASE_PROJECT_REF=your_supabase_project_ref_here

# 2. Your Supabase Database Password (e.g. MyDatabasePassword123)
SUPABASE_DB_PASSWORD=your_supabase_db_password_here
